# Optional deployment variables. The app reads environment variables from the host.
# Node can load this with: node --env-file=.env server.js
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/store.sqlite
# For public HTTPS deployment, set all three:
# HOST=0.0.0.0
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-store.example
